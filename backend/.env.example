# Copy to .env and fill in what you need. Never commit .env.

# Which AI provider analyzes text: gemini (our current setup) or openai
AI_PROVIDER=gemini

# Only the key for the provider you chose is required.
# Keep these EMPTY in this example file; put real keys only in your local .env.
GEMINI_API_KEY=
OPENAI_API_KEY=

# NOTE: reading images (PNG/JPG/WEBP) and scanned PDFs (OCR) always uses Gemini,
# so GEMINI_API_KEY is required for those even if AI_PROVIDER=openai.

# Optional BACKUP provider. When AI_PROVIDER=gemini and Gemini fails (unavailable, quota,
# timeout, bad output), NodeX automatically retries the same request on Groq. It also
# backs up image/scanned-PDF reading. Leave the key empty to disable the backup.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Model overrides
GEMINI_MODEL=gemini-3.7-flash
OPENAI_MODEL=gpt-4o-mini

# Optional: SQLite file location (default: backend/data/nodex.db)
# DB_PATH=

# Optional limits
MAX_UPLOAD_MB=10
MAX_TEXT_CHARS=20000
