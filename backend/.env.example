# Copy to .env and fill in what you need. Never commit .env.

# Choose ONE AI provider: openai or gemini
AI_PROVIDER=openai

# Only the key for the provider you chose is required
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional model overrides
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash

# Optional: SQLite file location (default: backend/data/nodex.db)
# DB_PATH=

# Optional limits
MAX_UPLOAD_MB=10
MAX_TEXT_CHARS=20000
